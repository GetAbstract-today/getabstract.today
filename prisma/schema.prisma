// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Url {
  id        String   @id @default(cuid())
  url       String
  date      DateTime
  category  String
  createdAt DateTime @default(now())
}

model Newsletter {
  id        String   @id @default(cuid())
  title     String?  // AI-generated email subject line
  content   String   // Full newsletter as Markdown
  category  String
  createdAt DateTime @default(now())
}

// One row per (email, category). One user can subscribe to many categories.
model Subscription {
  id        String   @id @default(cuid())
  email     String
  category  String   // Newsletter category id, e.g. "ai", "startups"
  createdAt DateTime @default(now())

  @@unique([email, category])
  @@index([email])
}

// Defines a newsletter topic/category with its prompt configuration.
// Each topic produces newsletters with a distinct persona, scope, sections, and sources.
model TopicProfile {
  id              String   @id @default(cuid())
  slug            String   @unique              // URL-safe identifier, e.g. "ai", "fintech"
  name            String                        // Display name, e.g. "AI & Machine Learning"
  icon            String                        // Emoji, e.g. "🧠"
  description     String                        // Shown on subscribe page
  tagline         String                        // Short marketing line

  // ── Prompt configuration ──
  role            String                        // e.g. "expert AI News Curator and Technical Writer"
  topicScope      String                        // e.g. "AI, machine learning, and data science"
  titlePrefix     String                        // e.g. "AI Daily"
  sections        String                        // JSON array of section configs
  prioritySources String[]                      // e.g. ["ArXiv", "TechCrunch"]
  toneNotes       String?                       // Optional tone/audience guidance
  exampleSubjects String[]                      // Example email subject lines for the AI

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
